# OpenBitFun browser gateway (openbitfun-link-gateway from
# src/apps/relay-server/link-gateway). Signs browsers in with the email code,
# lists the account's devices and pipes bytes between a browser WebSocket and
# a device's OBP port inside the account's Link network (the browser and the
# device run OBP's end-to-end channel inside; this process sees ciphertext).
# It mints its own account-network membership from the issuer key, so it runs
# as the issuer's user. Loopback listener only: browsers reach it as
# https://<domain>/obp/ (domain-only over HTTPS: the provider's front end and
# nginx forward it here).
# It also keeps the web UI pool (`/app/cas/`, files of the devices' web UI
# bundles by hash) in /var/lib/openbitfun-ui-pool (StateDirectory: a cache,
# safe to delete; 4 GiB cap, files unused for 30 days deleted daily).
# Install as /etc/systemd/system/openbitfun-link-gateway.service; see README.md.
[Unit]
Description=OpenBitFun browser gateway (Link)
After=network-online.target openbitfun-link-node.service
Wants=network-online.target

[Service]
Type=simple
User=openbitfun-mesh
Group=openbitfun-mesh
WorkingDirectory=/opt/openbitfun-link-gateway
Environment=LINK_GATEWAY_LISTEN=127.0.0.1:19730
Environment=MESH_ISSUER_KEY_FILE=/opt/openbitfun-mesh-issuer/etc/issuer.key
Environment=LINK_GATEWAY_RELAY_NODE=ws://127.0.0.1:11011/
Environment=LINK_GATEWAY_DIRECTORY_URL=http://127.0.0.1:19750
Environment=LINK_GATEWAY_SUPERAGENT_URL=http://127.0.0.1:19740
Environment=LINK_GATEWAY_AUTH_URL=https://auth.openbitfun.com/api/v1
Environment=LINK_GATEWAY_ORIGINS=https://super.openbitfun.com
Environment=LINK_GATEWAY_MEMBER=obf-gateway-lwb
Environment=LINK_GATEWAY_UI_POOL_DIR=/var/lib/openbitfun-ui-pool
Environment=LINK_GATEWAY_UI_POOL_MAX_BYTES=4294967296
Environment=LINK_GATEWAY_UI_POOL_MAX_AGE_DAYS=30
Environment=LINK_GATEWAY_UI_POOL_PULLS_PER_MINUTE=240
# easytier's "Failed to send event" warnings repeat every connection with the
# client's address; they carry no fault, so only their errors are logged.
Environment=RUST_LOG=info,easytier=warn,easytier_core=warn,easytier::common::global_ctx=error
ExecStart=/opt/openbitfun-link-gateway/bin/openbitfun-link-gateway
StateDirectory=openbitfun-ui-pool
StateDirectoryMode=0750
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=1G

[Install]
WantedBy=multi-user.target
