{
  "version": 1,
  "defaultLocale": "zh-CN",
  "fallbackLocale": "en-US",
  "unknownLocaleFallbackChain": [
    "en-US",
    "zh-CN"
  ],
  "surfaceDefaults": {
    "android": "zh-CN",
    "core": "zh-CN",
    "superagent": "en-US"
  },
  "surfaceOrders": {
    "core": [
      "zh-CN",
      "zh-TW",
      "en-US"
    ],
    "superagent": [
      "en-US",
      "zh-CN",
      "zh-TW"
    ]
  },
  "surfaces": {
    "core": {
      "resourceRoot": "src/crates/assembly/core/locales",
      "loading": "backend-service"
    },
    "relay-static-homepage": {
      "resourceRoot": "src/apps/relay-server/static/homepage",
      "loading": "self-contained-static"
    },
    "superagent": {
      "resourceRoot": "src/apps/relay-server/superagent/locales",
      "loading": "backend-service"
    }
  },
  "locales": [
    {
      "id": "zh-CN",
      "rustVariant": "ZhCN",
      "name": "简体中文",
      "englishName": "Simplified Chinese",
      "nativeName": "简体中文",
      "shortName": "中",
      "rtl": false,
      "dateFormat": "YYYY年MM月DD日",
      "numberFormat": {
        "decimal": ".",
        "thousands": ","
      },
      "aliases": [
        "zh",
        "zh-Hans",
        "zh-CN"
      ],
      "contentFallbacks": [
        "en-US"
      ],
      "modelLanguageName": "Simplified Chinese",
      "shortModelInstruction": "使用简体中文"
    },
    {
      "id": "en-US",
      "rustVariant": "EnUS",
      "name": "English",
      "englishName": "English (US)",
      "nativeName": "English",
      "shortName": "EN",
      "rtl": false,
      "dateFormat": "MM/DD/YYYY",
      "numberFormat": {
        "decimal": ".",
        "thousands": ","
      },
      "aliases": [
        "en",
        "en-US"
      ],
      "contentFallbacks": [
        "zh-CN"
      ],
      "modelLanguageName": "English",
      "shortModelInstruction": "Use English"
    },
    {
      "id": "zh-TW",
      "rustVariant": "ZhTW",
      "name": "繁體中文",
      "englishName": "Traditional Chinese",
      "nativeName": "繁體中文",
      "shortName": "繁",
      "rtl": false,
      "dateFormat": "YYYY年MM月DD日",
      "numberFormat": {
        "decimal": ".",
        "thousands": ","
      },
      "aliases": [
        "zh-TW",
        "zh-Hant",
        "zh-HK",
        "zh-MO"
      ],
      "contentFallbacks": [
        "zh-CN",
        "en-US"
      ],
      "modelLanguageName": "Traditional Chinese",
      "shortModelInstruction": "使用繁體中文"
    }
  ]
}
