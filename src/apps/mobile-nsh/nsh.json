{
  "name": "OpenBitFun",
  "id": "com.openbitfun.mobile",
  "version": "2.0.0",
  "build": 1,
  "rust": "./native",
  "icon": "../../../assets/brand/exports/openbitfun-app-icon-1024.png",
  "capabilities": {
    "clipboard": true,
    "notifications": true,
    "picker": true,
    "statusBar": true,
    "webview": {
      "hosts": [
        "*"
      ]
    },
    "openUrl": {
      "schemes": [
        "https",
        "http"
      ]
    }
  },
  "statusBar": {
    "foreground": "auto"
  }
}
