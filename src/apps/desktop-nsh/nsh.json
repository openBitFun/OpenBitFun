{
  "name": "OpenBitFun",
  "id": "com.openbitfun.desktop",
  "version": "2.0.0",
  "build": 1,
  "rust": "./native",
  "capabilities": {
    "application": true,
    "clipboard": true,
    "picker": true,
    "speech": true,
    "notifications": true,
    "statusBar": true,
    "webview": {
      "hosts": [
        "*"
      ],
      "input": true
    },
    "openUrl": {
      "schemes": [
        "https",
        "http"
      ]
    },
    "windows": true
  },
  "window": {
    "title": "OpenBitFun",
    "titleBar": {
      "style": "hidden",
      "height": 44
    },
    "defaultSize": {
      "width": 1200,
      "height": 800
    },
    "defaultPosition": "center",
    "minSize": {
      "width": 800,
      "height": 600
    },
    "restoreBounds": true,
    "closeOnPress": false
  }
}
