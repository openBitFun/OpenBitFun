# OpenBitFun mesh relay/discovery node: EasyTier easytier-core as a shared
# public node restricted to OpenBitFun account networks (`obf-*`).
# Install as /etc/systemd/system/openbitfun-easytier.service; see README.md.
[Unit]
Description=OpenBitFun mesh relay node (EasyTier)
Documentation=https://github.com/EasyTier/EasyTier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=easytier
Group=easytier
WorkingDirectory=/opt/easytier
ExecStart=/opt/easytier/bin/easytier-core --config-file /opt/easytier/etc/config.toml --rpc-portal 127.0.0.1:15888 --console-log-level warn --file-log-level warn --file-log-dir /opt/easytier/logs --file-log-size 50 --file-log-count 5
Restart=always
RestartSec=3
LimitNOFILE=65536
# No TUN device and no privileged ports: the node only relays and coordinates.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
# The release binaries are UPX-packed and unpack into W+X memory at start, so
# MemoryDenyWriteExecute must stay off (it makes the process SIGSEGV).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/opt/easytier/logs
MemoryMax=512M

[Install]
WantedBy=multi-user.target
